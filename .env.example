# Connection string do Supabase — Project Settings → Database → Connection string
# → separador "Transaction" (pooler/Supavisor). NÃO use a ligação directa
# (db.<ref>.supabase.co): é IPv6-only e o Render não tem saída IPv6.
#
# Note o formato: utilizador "postgres.<project-ref>" (com o ref colado ao
# utilizador) e anfitrião "aws-0-<região>.pooler.supabase.com", porta 6543.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
